---
import LiveEditor from "../components/LiveEditor.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

const title = "Live code editor";
const description =
  "A client-side live code editor for HTML, CSS, and JavaScript, inspired by CodePen.";
---

<BaseLayout
  title={`${title} · Javi Aguilar`}
  {description}
  image="/experiments/live-editor.webp"
  nav="editor"
>
  <header class="head">
    <p class="crumbs">
      <a href="/experiments/">CSS experiments</a>
    </p>
    <h1 class="page-title">{title}</h1>
    <p>
      {description} It uses CodeMirror, keeps your edits in local storage, and exports to CodePen.
    </p>
    <div class="btns">
      <a class="btn" href="/editor/fullscreen/">
        Open fullscreen
      </a>
      <a
        class="btn"
        href="https://github.com/itsjavi/itsjavi.github.io/blob/main/src/components/LiveEditor.astro"
      >
        View the component on GitHub
      </a>
    </div>
  </header>
  <LiveEditor />
</BaseLayout>

<style>
  .head {
    padding: 28px 0 24px;
  }
  .crumbs {
    margin: 0 0 10px;
    font-size: 14px;
  }
  .crumbs a {
    color: var(--accent);
  }
  .head > p:not(.crumbs) {
    color: var(--muted);
    margin: 8px 0 16px;
    font-size: 16px;
    max-width: 62ch;
  }
  .btns {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
</style>
