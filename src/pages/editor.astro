---
import BaseLayout from "../layouts/BaseLayout.astro";
import LiveEditor from "../components/LiveEditor.astro";
const title = "Live HTML/CSS/JS Code Editor similar to CodePen, built with Astro";
const description =
  "A client-side live code editor for HTML, CSS, and JavaScript, inspired by CodePen.";
---

<BaseLayout
  title={title}
  description={description}
  image="/experiments/live-editor.webp"
  sideBarActiveItemID="editor"
  wide
  transitions={false}
>
  <div class="flex min-w-0 flex-col gap-6">
    <div>
      <h1 class="mb-5 text-3xl font-bold">Live Code Editor</h1>
      <div class="divider my-2"></div>
      <p>
        {description} It uses CodeMirror under the hood. Edits are persisted to local storage.
        Optionally, you can easily export your code to CodePen.
      </p>
      <div class="flex flex-wrap gap-2 py-2 text-lg">
        <span class="badge badge-sm badge-outline rounded-full">Astro</span>
        <span class="badge badge-sm badge-outline rounded-full">TypeScript</span>
      </div>
    </div>
    <div>
      <a
        class="btn btn-neutral"
        href="https://github.com/itsjavi/itsjavi.github.io/blob/main/src/components/LiveEditor.astro"
        target="_blank"
        rel="noopener noreferrer"
      >
        View component on GitHub
      </a>
    </div>
    <LiveEditor />
    <div>
      <a class="btn btn-outline" href="/editor/fullscreen" data-astro-reload>
        Go Fullscreen
      </a>
    </div>
  </div>
</BaseLayout>
