---
import { FlaskConical } from "@lucide/astro";
import ContentCard from "../components/ContentCard.astro";
import experiments from "../data/experiments.json";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Experiments | Javi Aguilar" sideBarActiveItemID="experiments">
  <h1 class="mb-5 text-3xl font-bold">
    Experiments <FlaskConical class="inline-block" aria-hidden="true" />
  </h1>
  <div class="divide-y divide-base-content/10">
    {experiments.map((experiment) => (
      <div class="py-2">
        <ContentCard
          title={experiment.title}
          image={experiment.img}
          description={experiment.desc}
          href={`/experiments/${experiment.slug}`}
        />
      </div>
    ))}
  </div>
</BaseLayout>
