---
import { FlaskConical, Rocket } from "@lucide/astro";
import { getCollection } from "astro:content";
import ContentCard from "../components/ContentCard.astro";
import { IS_BLOG_ENABLED } from "../config";
import experiments from "../data/experiments.json";
import BaseLayout from "../layouts/BaseLayout.astro";

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const projects = (await getCollection("projects")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const recentPosts = posts.slice(0, 3);
const recentProjects = projects.slice(0, 3);
const recentExperiments = experiments.slice(0, 3);
---

<BaseLayout sideBarActiveItemID="home">
  <section class="mb-12 mt-5" aria-labelledby="intro-title">
    <p class="py-1 text-xl">Hi there! 👋</p>
    <h1 id="intro-title" class="text-5xl font-bold">
      I'm Javi Aguilar
    </h1>
    <p class="py-3 text-3xl font-bold">Full-Stack Software Engineer</p>
    <p class="py-2 text-lg">
      📍 Berlin. Passionate about web technologies and crafting good user experiences. I help teams
      launch successful products while experimenting and exploring new technologies through many
      side projects.
    </p>
    <div class="flex flex-wrap gap-2 py-2 text-lg" aria-label="Technologies">
      {["JavaScript", "TypeScript", "CSS", "HTML", "React", "Astro", "AWS", "Cloudflare"].map(
        (item) => (
          <span class="badge badge-sm badge-outline rounded-full">{item}</span>
        ),
      )}
    </div>
  </section>

  {IS_BLOG_ENABLED && recentPosts.length > 0 && (
    <section class="mb-10" aria-labelledby="recent-posts-title">
      <h2 id="recent-posts-title" class="mb-2 text-3xl font-bold">
        Recent posts
      </h2>
      <div class="divide-y divide-base-content/10">
        {recentPosts.map((post) => (
          <div class="py-2">
            <ContentCard
              title={post.data.title}
              image={post.data.heroImage}
              description={post.data.description}
              href={`/blog/${post.id}`}
              badge={post.data.badge}
            />
          </div>
        ))}
      </div>
    </section>
  )}

  <section aria-labelledby="latest-projects-title">
    <h2 id="latest-projects-title" class="mb-2 text-3xl font-bold">
      Latest projects <Rocket class="inline-block" aria-hidden="true" />
    </h2>
    <div class="divide-y divide-base-content/10">
      {recentProjects.map((project) => (
        <div class="py-2">
          <ContentCard
            title={project.data.title}
            image={project.data.img}
            description={project.data.desc}
            href={`/projects/${project.id}`}
            badge={project.data.badge}
          />
        </div>
      ))}
    </div>
    {projects.length > recentProjects.length && (
      <div class="mt-5 text-center">
        <a href="/projects" class="btn btn-outline">
          View more projects
        </a>
      </div>
    )}
  </section>

  <section class="mt-10" aria-labelledby="latest-experiments-title">
    <h2 id="latest-experiments-title" class="mb-2 text-3xl font-bold">
      Latest experiments <FlaskConical class="inline-block" aria-hidden="true" />
    </h2>
    <div class="divide-y divide-base-content/10">
      {recentExperiments.map((experiment) => (
        <div class="py-2">
          <ContentCard
            title={experiment.title}
            image={experiment.img}
            description={experiment.desc}
            href={`/experiments/${experiment.slug}`}
          />
        </div>
      ))}
    </div>
    {experiments.length > recentExperiments.length && (
      <div class="mt-5 text-center">
        <a href="/experiments" class="btn btn-outline">
          View more experiments
        </a>
      </div>
    )}
  </section>
</BaseLayout>
