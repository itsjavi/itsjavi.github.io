---
import experiments from "../../data/experiments.json";
import ExperimentLayout from "../../layouts/ExperimentLayout.astro";

export function getStaticPaths() {
  return experiments.map((experiment) => ({
    params: { slug: experiment.slug },
    props: { experiment },
  }));
}

type Experiment = (typeof experiments)[number];
interface Props {
  experiment: Experiment;
}

const { experiment } = Astro.props;
---

<ExperimentLayout
  title={experiment.title}
  description={experiment.desc}
  image={experiment.img}
  codepenUser={experiment.codepenUser}
  codepenId={experiment.codepenId}
/>
