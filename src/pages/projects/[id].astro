---
import { getCollection, render } from "astro:content";
import GiscusComments from "../../components/GiscusComments.astro";
import ProjectDetail from "../../components/ProjectDetail.astro";
import ArticleLayout from "../../layouts/ArticleLayout.astro";
import { getCatalog, type Project } from "../../lib/catalog";

export async function getStaticPaths() {
  return (await getCollection("projects")).map((project) => ({
    params: { id: project.id },
    props: { project },
  }));
}

interface Props {
  project: Project;
}

const { project } = Astro.props;
const { Content } = await render(project);
const item = (await getCatalog()).find((p) => p.id === project.id);
---

{item ? (
  <ProjectDetail item={item}>
    <Content />
  </ProjectDetail>
) : (
  <ArticleLayout
    title={project.data.name}
    description={project.data.description}
    image={project.data.img}
    noindex
  >
    <p slot="notice" class="retired">
      <b>Retired.</b> {project.data.name} is no longer maintained. This page stays for reference,
      but its website and code may no longer be available.
    </p>
    <Content frontmatter={project.data} />
    <GiscusComments slot="after" />
  </ArticleLayout>
)}

<style>
  .retired {
    margin: 0 0 24px;
    padding: 12px 16px;
    border-radius: 12px;
    background: var(--pill);
    color: var(--muted);
    font-size: 14.5px;
  }
  .retired b {
    color: var(--ink);
  }
</style>
