---
import type { GetStaticPaths, Page } from "astro";
import type { CollectionEntry } from "astro:content";
import { getCollection } from "astro:content";
import { Rocket } from "@lucide/astro";
import ContentCard from "../../components/ContentCard.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";

export const getStaticPaths = (async ({ paginate }) => {
  const projects = (await getCollection("projects")).sort(
    (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
  );
  return paginate(projects, { pageSize: 10 });
}) satisfies GetStaticPaths;

interface Props {
  page: Page<CollectionEntry<"projects">>;
}

const { page } = Astro.props;
---

<BaseLayout title="Projects | Javi Aguilar" sideBarActiveItemID="projects">
  <h1 class="mb-5 text-3xl font-bold">
    Projects <Rocket class="inline-block" aria-hidden="true" />
  </h1>
  <div class="divide-y divide-base-content/10">
    {page.data.map((project) => (
      <div class="py-2">
        <ContentCard
          title={project.data.title}
          image={project.data.img}
          description={project.data.desc}
          href={`/projects/${project.id}`}
          badge={project.data.badge}
        />
      </div>
    ))}
  </div>
  <nav class="mt-10 flex justify-between" aria-label="Project pages">
    {page.url.prev ? (
      <a class="btn btn-ghost" href={page.url.prev}>
        ← Newer projects
      </a>
    ) : (
      <span></span>
    )}
    {page.url.next && (
      <a class="btn btn-ghost" href={page.url.next}>
        Older projects →
      </a>
    )}
  </nav>
</BaseLayout>
