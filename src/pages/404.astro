---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Page not found · Javi Aguilar"
  description="The requested page could not be found."
  noindex
>
  <section class="nf">
    <p class="eyebrow">404</p>
    <h1 class="page-title">This page isn't here</h1>
    <p>It may have moved, or the project it belonged to was retired.</p>
    <div class="btns">
      <a class="btn btn-primary" href="/">
        Go to the home page
      </a>
      <button class="btn" type="button" data-search-open>
        Search
      </button>
    </div>
  </section>
</BaseLayout>

<style>
  .nf {
    padding: 96px 0 48px;
    text-align: center;
  }
  .eyebrow {
    color: var(--muted);
    margin: 0 0 12px;
  }
  .nf > p:not(.eyebrow) {
    color: var(--muted);
    margin: 12px 0 24px;
  }
  .btns {
    display: flex;
    justify-content: center;
    gap: 10px;
  }
  button {
    border: 0;
    font-family: var(--sans);
    color: var(--ink);
    cursor: pointer;
  }
</style>
