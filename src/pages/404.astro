---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="404 - Not Found"
  description="The requested page could not be found."
  includeSidebar={false}
>
  <div class="text-center">
    <div class="mb-4 text-9xl font-bold" aria-hidden="true">
      🏝
    </div>
    <h1 class="mb-2 text-9xl font-bold">404</h1>
    <p class="text-2xl">The page you're looking for couldn't be found.</p>
    <a class="btn btn-accent mt-9" href="/">
      Home
    </a>
  </div>
</BaseLayout>
