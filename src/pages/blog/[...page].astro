---
import type { GetStaticPaths, Page } from "astro";
import type { CollectionEntry } from "astro:content";
import { getCollection } from "astro:content";
import ContentCard from "../../components/ContentCard.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";

export const getStaticPaths = (async ({ paginate }) => {
  const posts = (await getCollection("blog")).sort(
    (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
  );
  return paginate(posts, { pageSize: 10 });
}) satisfies GetStaticPaths;

interface Props {
  page: Page<CollectionEntry<"blog">>;
}

const { page } = Astro.props;
---

<BaseLayout title="Blog | Javi Aguilar" sideBarActiveItemID="blog">
  <h1 class="mb-5 text-3xl font-bold">Blog</h1>
  <div class="divide-y divide-base-content/10">
    {page.data.map((post) => (
      <div class="py-2">
        <ContentCard
          title={post.data.title}
          image={post.data.heroImage}
          description={post.data.description}
          href={`/blog/${post.id}`}
          badge={post.data.badge}
          tags={post.data.tags}
          tagHrefPrefix="/blog/tag"
        />
      </div>
    ))}
  </div>
  <nav class="mt-10 flex justify-between" aria-label="Blog pages">
    {page.url.prev ? (
      <a class="btn btn-ghost" href={page.url.prev}>
        ← Recent posts
      </a>
    ) : (
      <span></span>
    )}
    {page.url.next && (
      <a class="btn btn-ghost" href={page.url.next}>
        Older posts →
      </a>
    )}
  </nav>
</BaseLayout>
