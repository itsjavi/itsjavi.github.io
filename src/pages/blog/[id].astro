---
import { render } from "astro:content";
import AppRow from "../../components/AppRow.astro";
import GiscusComments from "../../components/GiscusComments.astro";
import ArticleLayout from "../../layouts/ArticleLayout.astro";
import { getCatalog } from "../../lib/catalog";
import { getPosts, type Post, postDescription, readingTime } from "../../lib/posts";

export async function getStaticPaths() {
  return (await getPosts()).map((post) => ({ params: { id: post.id }, props: { post } }));
}

interface Props {
  post: Post;
}

const { post } = Astro.props;
const { Content } = await render(post);
const related = (await getCatalog()).filter((p) => post.data.projects.includes(p.id));
---

<ArticleLayout
  title={post.data.title}
  description={postDescription(post)}
  image={post.data.heroImage}
  pubDate={post.data.pubDate}
  updatedDate={post.data.updatedDate}
  readTime={readingTime(post.body)}
  tags={post.data.tags}
  nav="writing"
  crumb={{ label: "Writing", href: "/blog/" }}
>
  <Content />
  <Fragment slot="after">
    {related.length > 0 && (
      <aside class="related" aria-label="Related">
        {related.map((item) => (
          <AppRow item={item} />
        ))}
      </aside>
    )}
    <GiscusComments term={post.data.discussion} />
  </Fragment>
</ArticleLayout>

<style>
  .related {
    margin-top: 40px;
    border-top: 1px solid var(--line);
  }
</style>
