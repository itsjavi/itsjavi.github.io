---
import BaseHead from "../components/BaseHead.astro";
import SearchDialog from "../components/SearchDialog.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import TabBar from "../components/TabBar.astro";
import ThirdParties from "../components/ThirdParties.astro";
import { type NavId, SITE_DESCRIPTION, SITE_TITLE } from "../config";

export interface Props {
  title?: string;
  description?: string;
  image?: string;
  ogType?: string;
  nav?: NavId;
  noindex?: boolean;
}

const {
  title = SITE_TITLE,
  description = SITE_DESCRIPTION,
  image,
  ogType,
  nav,
  noindex,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead {title} {description} {image} {ogType} {noindex} />
    <ThirdParties />
  </head>
  <body>
    <SiteHeader active={nav} />
    <main class="page">
      <slot />
    </main>
    <SiteFooter />
    <TabBar active={nav} />
    <SearchDialog />
  </body>
</html>
