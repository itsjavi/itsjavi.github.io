---
import type { NavId } from "../config";
import BaseLayout from "./BaseLayout.astro";

export interface Props {
  title: string;
  description: string;
  image?: string;
  pubDate?: Date;
  updatedDate?: Date;
  readTime?: string;
  tags?: string[];
  nav?: NavId;
  crumb?: { label: string; href: string };
  noindex?: boolean;
  /** Show the image above the content; it is always used for social previews. */
  cover?: boolean;
}

const {
  title,
  description,
  image,
  pubDate,
  updatedDate,
  readTime,
  tags = [],
  nav,
  crumb,
  noindex,
  cover = true,
} = Astro.props;
const formatDate = (date: Date) =>
  new Intl.DateTimeFormat("en", { dateStyle: "medium" }).format(date);
---

<BaseLayout {title} {description} {image} ogType="article" {nav} {noindex}>
  <article class="article">
    {crumb && (
      <nav class="crumbs" aria-label="Breadcrumb">
        <a href={crumb.href}>{crumb.label}</a>
      </nav>
    )}
    <header>
      <h1>{title}</h1>
      {(pubDate || tags.length > 0) && (
        <p class="meta">
          {pubDate && <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>}
          {readTime && <span>{readTime}</span>}
          {tags.map((tag) => (
            <a href={`/blog/tag/${encodeURIComponent(tag)}/`}>#{tag}</a>
          ))}
        </p>
      )}
      {updatedDate && (
        <p class="meta">
          Updated <time datetime={updatedDate.toISOString()}>{formatDate(updatedDate)}</time>
        </p>
      )}
    </header>
    <slot name="notice" />
    {cover && image && <img class="cover" src={image} alt="" width="760" height="428" />}
    <div class="prose prose-lg prose-site max-w-none prose-img:mx-auto">
      <slot />
    </div>
    <slot name="after" />
  </article>
</BaseLayout>

<style>
  .article {
    max-width: 760px;
    margin-inline: auto;
    padding-top: 28px;
  }
  .crumbs {
    color: var(--muted);
    font-size: 14px;
    margin-bottom: 14px;
  }
  .crumbs a {
    color: var(--accent);
  }
  header {
    margin-bottom: 24px;
  }
  h1 {
    font: 700 40px/1.08 var(--display);
    letter-spacing: -0.03em;
    margin: 0 0 12px;
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 14px;
    margin: 0;
    color: var(--muted);
    font-size: 14px;
  }
  .meta a {
    color: var(--accent);
  }
  .cover {
    width: 100%;
    height: auto;
    aspect-ratio: 760 / 428;
    object-fit: cover;
    border-radius: 14px;
    border: 1px solid var(--line);
    margin-bottom: 28px;
  }
  @media (max-width: 860px) {
    .article {
      padding-top: 18px;
    }
    h1 {
      font-size: 30px;
    }
  }
</style>
