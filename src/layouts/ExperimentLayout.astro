---
import CodePen from "../components/CodePen.astro";
import GiscusComments from "../components/GiscusComments.astro";
import ArticleLayout from "./ArticleLayout.astro";

export interface Props {
  title: string;
  description: string;
  image: string;
  codepenUser: string;
  codepenId: string;
}

const { title, description, image, codepenUser, codepenId } = Astro.props;
---

<ArticleLayout
  {title}
  {description}
  {image}
  cover={false}
  nav="experiments"
  crumb={{ label: "CSS experiments", href: "/experiments/" }}
>
  <p>{description}</p>
  <CodePen user={codepenUser} penId={codepenId} {title} height="480" />
  <GiscusComments slot="after" />
</ArticleLayout>
