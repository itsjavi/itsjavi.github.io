---
import "../styles/global.css";

export interface Props {
  title: string;
  description: string;
  image?: string;
  ogType?: string;
  noindex?: boolean;
}

const {
  title,
  description,
  image = "/social_img.webp",
  ogType = "website",
  noindex = false,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url);
const socialImage = new URL(image, Astro.site ?? Astro.url);
---

<meta charset="utf-8" />
<script is:inline>
  // Apply the saved theme before first paint. No saved choice means "follow the system".
  try {
    const theme = localStorage.getItem("theme");
    if (theme === "light" || theme === "dark") document.documentElement.dataset.theme = theme;
  } catch {}
</script>
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="generator" content={Astro.generator} />
<meta name="theme-color" content="#f4f5f7" media="(prefers-color-scheme: light)" />
<meta name="theme-color" content="#0e1014" media="(prefers-color-scheme: dark)" />
{noindex && <meta name="robots" content="noindex" />}
<link rel="icon" type="image/webp" href="/favicon.webp" />
<link rel="canonical" href={canonical} />
<link
  rel="alternate"
  type="application/rss+xml"
  title="Javi Aguilar"
  href={new URL("/rss.xml", Astro.site ?? Astro.url)}
/>

<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />

<meta property="og:type" content={ogType} />
<meta property="og:url" content={canonical} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={socialImage} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:url" content={canonical} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={socialImage} />
