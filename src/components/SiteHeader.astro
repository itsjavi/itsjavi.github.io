---
import profile from "../assets/profile.jpg";
import { Image } from "astro:assets";
import { NAV_ITEMS, type NavId, PROFILE } from "../config";
import ThemeToggle from "./ThemeToggle.astro";

interface Props {
  active?: NavId;
}

const { active } = Astro.props;
---

<header class="top">
  <div class="bar">
    <a class="me" href="/">
      <Image src={profile} alt="" width={28} height={28} densities={[1, 2]} />
      {PROFILE.name}
    </a>
    <nav class="tabs" aria-label="Main">
      {NAV_ITEMS.map((item) => (
        <a href={item.href} aria-current={item.id === active ? "page" : undefined}>
          {item.label}
        </a>
      ))}
    </nav>
    <button
      class="search"
      type="button"
      data-search-open
      aria-label="Search apps, libraries and posts"
    >
      <svg
        width="14"
        height="14"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2.4"
        aria-hidden="true"
      >
        <circle cx="11" cy="11" r="7"></circle>
        <path d="m20 20-3.5-3.5"></path>
      </svg>
      <span>Search apps and libraries</span>
      <kbd>⌘K</kbd>
    </button>
    <a class="editor" href="/editor/" aria-current={active === "editor" ? "page" : undefined}>
      <svg
        width="15"
        height="15"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2.4"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="m8 7-5 5 5 5M16 7l5 5-5 5"></path>
      </svg>
      <span class="full">Code editor</span>
      <span class="short">Editor</span>
    </a>
    <ThemeToggle />
  </div>
</header>

<style>
  .top {
    position: sticky;
    top: env(safe-area-inset-top, 0px);
    z-index: 20;
    background: color-mix(in oklab, var(--bg) 82%, transparent);
    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);
    border-bottom: 1px solid var(--line);
  }
  .bar {
    max-width: var(--page);
    margin-inline: auto;
    padding: 12px var(--gutter);
    display: flex;
    align-items: center;
    gap: 24px;
  }
  .me {
    display: flex;
    align-items: center;
    gap: 10px;
    font-weight: 600;
    letter-spacing: -0.01em;
    white-space: nowrap;
  }
  .me img {
    width: 28px;
    height: 28px;
    border-radius: 50%;
  }
  .tabs {
    display: flex;
    gap: 4px;
    margin-left: 12px;
  }
  .tabs a {
    padding: 6px 12px;
    border-radius: 999px;
    color: var(--muted);
    font-weight: 500;
  }
  .tabs a:hover {
    color: var(--ink);
  }
  .tabs a[aria-current="page"] {
    background: var(--pill);
    color: var(--ink);
  }
  .search {
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: 8px;
    width: 260px;
    padding: 7px 10px;
    border: 0;
    border-radius: 9px;
    background: var(--pill);
    color: var(--muted);
    font: 13.5px var(--sans);
    cursor: pointer;
    text-align: left;
  }
  .search kbd {
    margin-left: auto;
    font: 12px var(--sans);
    border: 1px solid var(--line);
    border-radius: 5px;
    padding: 1px 5px;
    background: var(--surface);
  }
  /* The live code editor is the most visited page, so it stays in the header at every width. */
  .editor {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    margin-left: -12px;
    padding: 6px 12px;
    border-radius: 9px;
    background: var(--accent-soft);
    color: var(--accent);
    font-size: 13.5px;
    font-weight: 600;
    white-space: nowrap;
  }
  .editor:hover,
  .editor[aria-current="page"] {
    background: var(--accent-fill);
    color: var(--on-accent);
  }
  .editor .short {
    display: none;
  }
  .bar > :global(.theme) {
    margin-left: -12px;
  }
  @media (max-width: 860px) {
    .tabs,
    .search {
      display: none;
    }
    .editor {
      margin-left: auto;
    }
    .editor .full {
      display: none;
    }
    .editor .short {
      display: inline;
    }
    .bar {
      padding-block: 10px;
    }
  }
</style>
