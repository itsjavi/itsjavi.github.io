---
import SidebarContent from "./SidebarContent.astro";

export interface Props {
  activeItem?: string;
}

const { activeItem } = Astro.props;
---

<header class="sticky top-0 z-30 h-16 bg-base-100/90 shadow-sm backdrop-blur lg:hidden">
  <div class="navbar h-16 min-h-16">
    <div class="navbar-start">
      <button
        type="button"
        class="btn btn-square btn-ghost"
        aria-label="Open navigation"
        aria-controls="site-drawer"
        aria-expanded="false"
        data-drawer-open
      >
        <svg
          aria-hidden="true"
          viewBox="0 0 24 24"
          class="size-5 fill-none stroke-current"
          stroke-width="2"
        >
          <path stroke-linecap="round" d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
      </button>
    </div>
    <div class="navbar-center">
      <a class="btn btn-ghost text-xl font-normal" href="/">
        Javi Aguilar 👨🏻‍💻
      </a>
    </div>
    <div class="navbar-end"></div>
  </div>
</header>

<dialog
  id="site-drawer"
  class="m-0 h-dvh max-h-dvh w-[19rem] max-w-[calc(100vw-2rem)] bg-base-200 p-0 backdrop:bg-black/55 lg:hidden"
>
  <div class="relative h-full">
    <button
      type="button"
      class="btn btn-circle btn-ghost absolute right-2 top-2 z-10"
      aria-label="Close navigation"
      data-drawer-close
    >
      <span aria-hidden="true" class="text-2xl">
        ×
      </span>
    </button>
    <SidebarContent activeItem={activeItem} />
  </div>
</dialog>

<script>
  const drawerState = window as Window & {
    __siteDrawerReady?: boolean;
    __siteDrawerOpener?: HTMLElement;
  };

  if (!drawerState.__siteDrawerReady) {
    drawerState.__siteDrawerReady = true;

    document.addEventListener("click", (event) => {
      const target = event.target;
      if (!(target instanceof Element)) return;

      const openButton = target.closest<HTMLElement>("[data-drawer-open]");
      const closeButton = target.closest<HTMLElement>("[data-drawer-close]");
      const drawer = document.querySelector<HTMLDialogElement>("#site-drawer");

      if (openButton && drawer) {
        drawerState.__siteDrawerOpener = openButton;
        openButton.setAttribute("aria-expanded", "true");
        drawer.showModal();
        drawer.querySelector<HTMLElement>("[data-drawer-close]")?.focus();
      } else if (closeButton && drawer?.open) {
        drawer.close();
      } else if (target === drawer) {
        drawer.close();
      }
    });

    document.addEventListener(
      "close",
      (event) => {
        if (!(event.target instanceof HTMLDialogElement) || event.target.id !== "site-drawer")
          return;
        drawerState.__siteDrawerOpener?.setAttribute("aria-expanded", "false");
        drawerState.__siteDrawerOpener?.focus();
      },
      true,
    );
  }
</script>
