---
import type { NavId } from "../config";

interface Props {
  active?: NavId;
}

const { active } = Astro.props;

const icon = (d: string) =>
  `url("data:image/svg+xml;utf8,${encodeURIComponent(`<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="black" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">${d}</svg>`)}")`;

const items = [
  {
    id: "discover",
    label: "Discover",
    href: "/",
    icon: icon(
      '<rect x="3" y="3" width="8" height="8" rx="2"/><rect x="13" y="3" width="8" height="8" rx="2"/><rect x="3" y="13" width="8" height="8" rx="2"/><rect x="13" y="13" width="8" height="8" rx="2"/>',
    ),
  },
  {
    id: "apps",
    label: "Apps",
    href: "/projects/",
    icon: icon('<rect x="3" y="4" width="18" height="14" rx="3"/><path d="M8 21h8"/>'),
  },
  {
    id: "libraries",
    label: "Libraries",
    href: "/projects/libraries/",
    icon: icon('<path d="M21 8 12 3 3 8l9 5 9-5Z"/><path d="M3 8v8l9 5 9-5V8"/>'),
  },
  {
    id: "writing",
    label: "Writing",
    href: "/blog/",
    icon: icon(
      '<rect x="4" y="2" width="16" height="20" rx="2"/><path d="M16 2v20M2 6h4M2 10h4M2 14h4M2 18h4"/>',
    ),
  },
];
const searchIcon = icon('<circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/>');
---

<nav class="tabbar" aria-label="Main">
  {items.map((item) => (
    <a href={item.href} aria-current={item.id === active ? "page" : undefined}>
      <i style={`--icon:${item.icon}`} aria-hidden="true" />
      {item.label}
    </a>
  ))}
  <button type="button" data-search-open>
    <i style={`--icon:${searchIcon}`} aria-hidden="true"></i>
    Search
  </button>
</nav>

<style>
  .tabbar {
    display: none;
  }
  @media (max-width: 860px) {
    .tabbar {
      display: flex;
      position: fixed;
      inset-inline: 0;
      bottom: 0;
      z-index: 20;
      justify-content: space-around;
      padding: 8px 8px calc(8px + env(safe-area-inset-bottom, 0px));
      background: color-mix(in oklab, var(--surface) 88%, transparent);
      backdrop-filter: blur(18px);
      -webkit-backdrop-filter: blur(18px);
      border-top: 1px solid var(--line);
    }
    a,
    button {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 3px;
      min-width: 56px;
      border: 0;
      background: none;
      color: var(--muted);
      font: 10.5px var(--sans);
      cursor: pointer;
    }
    [aria-current="page"] {
      color: var(--accent);
    }
    i {
      width: 24px;
      height: 24px;
      background: currentColor;
      mask: var(--icon) center / contain no-repeat;
      -webkit-mask: var(--icon) center / contain no-repeat;
    }
  }
</style>
