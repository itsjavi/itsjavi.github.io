---
import { ChevronsDownUp } from "@lucide/astro";

interface Props {
  fullscreen?: boolean;
}

const { fullscreen = false } = Astro.props;
const initial = {
  title: "hello-world.html",
  html: "<h1>Hello, World!</h1>\n",
  css: "html { color-scheme: dark;}\nbody { font-family: Arial, sans-serif; }\n",
  js: "console.log('Hello from the code editor!');\n",
};
const languages = ["html", "css", "js"] as const;
---

<live-code-editor class:list={["live-editor", { fullscreen }]}>
  <form action="https://codepen.io/pen/define" method="post" target="_blank">
    <input type="hidden" name="data" value={JSON.stringify(initial)} />
    <section class="editors" aria-label="Code editors">
      <div class="editor-toolbar">
        <div role="tablist" aria-label="Editor language">
          {languages.map((language, index) => (
            <button
              type="button"
              role="tab"
              id={`tab-${language}`}
              aria-controls={`panel-${language}`}
              aria-selected={index === 0}
              tabindex={index === 0 ? 0 : -1}
              data-language={language}
            >
              {language.toUpperCase()}
            </button>
          ))}
        </div>
        <button class="export-button" type="submit">
          Export to CodePen
          <svg
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            aria-hidden="true"
          >
            <path d="m12 2 10 6.5v7L12 22 2 15.5v-7L12 2Zm0 0v6.5m0 7V22M2 8.5l10 7 10-7M2 15.5l10-7 10 7" />
          </svg>
        </button>
      </div>
      {languages.map((language, index) => (
        <div
          class="editor-panel"
          role="tabpanel"
          id={`panel-${language}`}
          aria-labelledby={`tab-${language}`}
          hidden={index !== 0}
          data-editor={language}
        >
          <pre>{initial[language]}</pre>
        </div>
      ))}
    </section>
    <section class="preview" aria-label="Live preview">
      <div class="preview-toolbar">
        <input
          class="preview-title"
          aria-label="Document title"
          value={initial.title}
          spellcheck="false"
        />
        <button
          class="toggle-editors"
          type="button"
          aria-label="Toggle editors"
          aria-expanded="true"
        >
          <ChevronsDownUp size={16} />
        </button>
      </div>
      <iframe title="Code preview" sandbox="allow-scripts" referrerpolicy="no-referrer"></iframe>
    </section>
  </form>
  <p class="storage-status" role="status" hidden></p>
</live-code-editor>

<script>
  import "../scripts/live-editor";
</script>

<style>
  .live-editor {
    display: block;
    height: 500px;
    min-width: 0;
  }
  .fullscreen {
    height: 100dvh;
  }
  form {
    display: grid;
    grid-template-rows: minmax(0, 2fr) minmax(0, 3fr);
    height: 100%;
    border: 1px solid #374151;
  }
  form[data-collapsed] {
    grid-template-rows: minmax(0, 1fr);
  }
  .editors,
  .preview {
    display: flex;
    flex-direction: column;
    min-height: 0;
    min-width: 0;
  }
  .editors[hidden] {
    display: none;
  }
  .editors {
    background: #111827;
  }
  .editor-toolbar,
  .preview-toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-shrink: 0;
    background: #374151;
    color: white;
    font-size: 14px;
    font-weight: 700;
  }
  [role="tablist"] {
    display: flex;
  }
  [role="tab"],
  .export-button {
    padding: 12px 16px;
    cursor: pointer;
  }
  [role="tab"][aria-selected="true"] {
    background: #4b5563;
  }
  .export-button {
    display: flex;
    align-items: center;
    gap: 8px;
    color: #9ca3af;
  }
  .export-button:hover {
    color: white;
  }
  .editor-panel {
    flex: 1;
    min-height: 0;
    overflow: auto;
  }
  .preview {
    background: black;
  }
  .preview-toolbar {
    padding: 10px 16px;
    gap: 12px;
  }
  .preview-title {
    min-width: 0;
    flex: 1;
    background: transparent;
    border: 0;
    padding: 0;
    font: inherit;
    color: inherit;
  }
  .preview-title:focus {
    outline-offset: 3px;
  }
  .toggle-editors {
    cursor: pointer;
    padding: 4px 8px;
    color: #9ca3af;
  }
  iframe {
    flex: 1;
    width: 100%;
    min-height: 0;
    border: 0;
  }
  button:focus-visible {
    outline: 2px solid white;
    outline-offset: -3px;
  }
  .storage-status {
    margin: 4px 0;
    font-size: 14px;
  }
  @media (max-width: 480px) {
    [role="tab"],
    .export-button {
      padding: 12px 10px;
    }
    .export-button {
      gap: 4px;
      font-size: 12px;
    }
  }
</style>
