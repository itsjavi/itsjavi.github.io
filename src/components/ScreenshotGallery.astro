---
import type { ImageMetadata } from "astro";
import { getImage, Image } from "astro:assets";

interface Props {
  images: ImageMetadata[];
  name: string;
}

const { images, name } = Astro.props;
const shown = images.slice(0, 3);
// Large versions for the full-screen viewer; the links also work without JavaScript.
const full = await Promise.all(
  images.map(async (image, i) => ({
    src: (await getImage({ src: image, width: Math.min(image.width, 2400), format: "webp" })).src,
    alt: `${name} screenshot ${i + 1}`,
  })),
);
---

<section
  class:list={["gallery", `n${shown.length}`]}
  aria-label="Screenshots"
  data-gallery={JSON.stringify(full)}
>
  {shown.map((image, i) => (
    <a href={full[i].src} data-index={i} aria-label={`Open ${full[i].alt}`}>
      <Image
        src={image}
        alt={full[i].alt}
        widths={i === 0 ? [720, 1200, 1600] : [480, 720]}
        sizes={i === 0 ? "(max-width: 860px) 92vw, 760px" : "(max-width: 860px) 92vw, 380px"}
      />
      {i === shown.length - 1 && images.length > shown.length && (
        <span class="more">+{images.length - shown.length}</span>
      )}
      {i === 0 && images.length > 1 && <span class="more more-sm">+{images.length - 1}</span>}
    </a>
  ))}
</section>

<dialog class="viewer" aria-label={`${name} screenshots`}>
  <figure>
    <img alt="" />
    <figcaption aria-live="polite"></figcaption>
  </figure>
  <button type="button" class="close" aria-label="Close">
    <svg
      width="18"
      height="18"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2.4"
      stroke-linecap="round"
      aria-hidden="true"
    >
      <path d="M6 6l12 12M18 6 6 18"></path>
    </svg>
  </button>
  <button type="button" class="prev" aria-label="Previous screenshot">
    <svg
      width="20"
      height="20"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2.4"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path d="m15 5-7 7 7 7"></path>
    </svg>
  </button>
  <button type="button" class="next" aria-label="Next screenshot">
    <svg
      width="20"
      height="20"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2.4"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path d="m9 5 7 7-7 7"></path>
    </svg>
  </button>
</dialog>

<script>
  type Shot = { src: string; alt: string };

  for (const gallery of document.querySelectorAll<HTMLElement>("[data-gallery]")) {
    const shots: Shot[] = JSON.parse(gallery.dataset.gallery!);
    const viewer = gallery.nextElementSibling as HTMLDialogElement;
    const img = viewer.querySelector("img")!;
    const caption = viewer.querySelector("figcaption")!;
    const single = shots.length < 2;
    let index = 0;

    viewer.querySelector<HTMLButtonElement>(".prev")!.hidden = single;
    viewer.querySelector<HTMLButtonElement>(".next")!.hidden = single;

    function show(next: number) {
      index = (next + shots.length) % shots.length;
      img.src = shots[index].src;
      img.alt = shots[index].alt;
      caption.textContent = single ? "" : `${index + 1} / ${shots.length}`;
      // Warm the neighbours so arrowing through feels instant.
      for (const offset of [1, -1])
        new Image().src = shots[(index + offset + shots.length) % shots.length].src;
    }

    gallery.addEventListener("click", (event) => {
      const link = (event.target as Element).closest<HTMLAnchorElement>("a[data-index]");
      if (!link) return;
      event.preventDefault();
      show(Number(link.dataset.index));
      viewer.showModal();
    });
    viewer.querySelector(".close")!.addEventListener("click", () => viewer.close());
    viewer.querySelector(".prev")!.addEventListener("click", () => show(index - 1));
    viewer.querySelector(".next")!.addEventListener("click", () => show(index + 1));
    viewer.addEventListener("click", (event) => {
      // Clicks on the dark area around the image close the viewer.
      if (event.target === viewer || event.target === viewer.querySelector("figure"))
        viewer.close();
    });
    viewer.addEventListener("keydown", (event) => {
      if (single) return;
      if (event.key === "ArrowRight") show(index + 1);
      if (event.key === "ArrowLeft") show(index - 1);
    });

    let startX: number | undefined;
    viewer.addEventListener("pointerdown", (event) => (startX = event.clientX));
    viewer.addEventListener("pointerup", (event) => {
      if (startX === undefined || single) return;
      const dx = event.clientX - startX;
      startX = undefined;
      if (Math.abs(dx) > 50) show(index + (dx < 0 ? 1 : -1));
    });
  }
</script>

<style>
  .gallery {
    display: grid;
    gap: 14px;
    margin-top: 28px;
  }
  .gallery.n2 {
    grid-template-columns: 2fr 1fr;
  }
  .gallery.n3 {
    grid-template-columns: 2fr 1fr 1fr;
  }
  .gallery a {
    position: relative;
    display: block;
    cursor: zoom-in;
    border-radius: 12px;
  }
  .gallery img {
    width: 100%;
    height: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    object-position: top left;
    border-radius: 12px;
    border: 1px solid var(--line);
    transition: filter 0.2s;
  }
  .gallery a:hover img {
    filter: brightness(1.06);
  }
  .gallery.n1 img {
    height: auto;
    aspect-ratio: auto;
  }
  .more-sm {
    display: none;
  }
  .more {
    position: absolute;
    right: 10px;
    bottom: 10px;
    padding: 4px 10px;
    border-radius: 999px;
    background: rgb(16 17 22 / 0.7);
    color: #fff;
    font-size: 13px;
    font-weight: 600;
  }

  .viewer {
    width: 100vw;
    height: 100dvh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: rgb(8 10 14 / 0.9);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    color: #fff;
    overscroll-behavior: contain;
    touch-action: pan-y;
  }
  .viewer::backdrop {
    background: transparent;
  }
  .viewer[open] {
    display: grid;
    place-items: center;
  }
  :global(html:has(.viewer[open])) {
    overflow: hidden;
  }
  figure {
    margin: 0;
    width: 100%;
    height: 100%;
    display: grid;
    place-items: center;
    padding: 56px 88px 48px;
    box-sizing: border-box;
  }
  figure img {
    max-width: 100%;
    max-height: calc(100dvh - 120px);
    width: auto;
    height: auto;
    object-fit: contain;
    border-radius: 10px;
    box-shadow: 0 24px 80px rgb(0 0 0 / 0.5);
    user-select: none;
    -webkit-user-drag: none;
  }
  figcaption {
    position: absolute;
    bottom: calc(14px + env(safe-area-inset-bottom, 0px));
    left: 50%;
    transform: translateX(-50%);
    font-size: 13px;
    font-variant-numeric: tabular-nums;
    color: rgb(255 255 255 / 0.7);
  }
  .viewer button {
    position: absolute;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 0;
    border-radius: 50%;
    background: rgb(255 255 255 / 0.12);
    color: #fff;
    cursor: pointer;
  }
  .viewer button:hover {
    background: rgb(255 255 255 / 0.22);
  }
  .close {
    top: calc(14px + env(safe-area-inset-top, 0px));
    right: 14px;
  }
  .prev,
  .next {
    top: 50%;
    transform: translateY(-50%);
  }
  .prev {
    left: 20px;
  }
  .next {
    right: 20px;
  }
  @media (max-width: 860px) {
    .gallery.n2,
    .gallery.n3 {
      grid-template-columns: minmax(0, 1fr);
    }
    .gallery a:nth-child(n + 2) {
      display: none;
    }
    .more {
      display: none;
    }
    .more.more-sm {
      display: block;
    }
    figure {
      padding: 64px 12px 72px;
    }
    .prev,
    .next {
      top: auto;
      bottom: calc(8px + env(safe-area-inset-bottom, 0px));
      transform: none;
    }
    .prev {
      left: 16px;
    }
    .next {
      right: 16px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .gallery img {
      transition: none;
    }
  }
</style>
