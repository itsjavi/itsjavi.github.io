---
import { type Post, postDescription, readingTime } from "../lib/posts";

interface Props {
  posts: Post[];
}

const { posts } = Astro.props;
const formatDate = (date: Date) =>
  new Intl.DateTimeFormat("en", { dateStyle: "medium" }).format(date);
---

<ol class="posts">
  {posts.map((post) => (
    <li>
      <a href={`/blog/${post.id}/`}>
        <h2>
          {post.data.title}
          {post.data.draft && <span class="badge">Draft</span>}
        </h2>
        <p>{postDescription(post)}</p>
        <span class="meta">
          <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time> ·{" "}
          {readingTime(post.body)}
        </span>
      </a>
    </li>
  ))}
</ol>

<style>
  .posts {
    list-style: none;
    margin: 0;
    padding: 0;
    max-width: 760px;
  }
  li {
    border-bottom: 1px solid var(--line);
  }
  a {
    display: block;
    padding: 20px 0;
  }
  h2 {
    display: flex;
    align-items: center;
    gap: 10px;
    font: 650 21px/1.25 var(--display);
    letter-spacing: -0.015em;
    margin: 0 0 6px;
  }
  a:hover h2 {
    color: var(--accent);
  }
  p {
    margin: 0 0 8px;
    color: var(--muted);
  }
  .meta {
    color: var(--muted);
    font-size: 13px;
  }
</style>
