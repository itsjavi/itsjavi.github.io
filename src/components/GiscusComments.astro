<giscus-comments class="block">
  <div class="giscus"></div>
</giscus-comments>

<script>
  // Initialize after ClientRouter finishes replaying page scripts so it cannot replay this widget.
  document.addEventListener("astro:page-load", () => {
    for (const host of document.querySelectorAll("giscus-comments")) {
      if (host.querySelector("script")) continue;
      const script = document.createElement("script");
      script.src = "https://giscus.app/client.js";
      script.async = true;
      script.crossOrigin = "anonymous";
      Object.assign(script.dataset, {
        repo: "itsjavi/itsjavi.github.io",
        repoId: "MDEwOlJlcG9zaXRvcnk2ODMzMzcwNw==",
        category: "Pages Discussion",
        categoryId: "DIC_kwDOBBKwi84CjvAI",
        mapping: "pathname",
        strict: "0",
        reactionsEnabled: "1",
        emitMetadata: "0",
        inputPosition: "top",
        theme: "transparent_dark",
        lang: "en",
        loading: "lazy",
      });
      host.append(script);
    }
  });
</script>
