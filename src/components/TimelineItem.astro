---
export interface Props {
  title: string;
  subtitle: string;
}

const { title, subtitle } = Astro.props;
---

<div class="flex">
  <div aria-hidden="true">
    <span class="mt-1 block size-4 rounded-full bg-primary"></span>
    <span class="timeline-line block h-full w-0.5 translate-x-[7px] bg-primary"></span>
  </div>
  <div class="px-5">
    <h3 class="mb-1 font-semibold">{title}</h3>
    <span class="text-sm font-light">{subtitle}</span>
    <p class="my-2 text-justify">
      <slot />
    </p>
  </div>
</div>
