{
  "name": "itsjavi-dotcom",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "format": "oxfmt . && prettier \"src/**/*.astro\" --write",
    "format:check": "oxfmt . --check && prettier \"src/**/*.astro\" --check",
    "lint:oxlint": "oxlint . --deny-warnings",
    "lint:astro": "eslint \"src/**/*.astro\" --max-warnings 0",
    "check": "astro check",
    "lint": "pnpm lint:oxlint && pnpm lint:astro && pnpm check",
    "new:post": "node scripts/new-post.mjs"
  },
  "dependencies": {
    "@astrojs/mdx": "^8.1.6",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.6",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@lucide/astro": "^1.79.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.5",
    "astro": "^7.4.13",
    "codemirror": "^6.0.2",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "eslint": "^10.15.0",
    "eslint-plugin-astro": "^3.2.1",
    "oxfmt": "^0.80.0",
    "oxlint": "^1.95.0",
    "prettier": "^3.10.1",
    "prettier-plugin-astro": "^1.1.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.74.0"
  },
  "engines": {
    "node": "^24.16.0 || ^26.3.0"
  },
  "packageManager": "pnpm@12.23.0"
}
