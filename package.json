{
  "name": "itsjavi-dotcom",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "format": "oxfmt . && prettier \"src/**/*.astro\" --write",
    "format:check": "oxfmt . --check && prettier \"src/**/*.astro\" --check",
    "lint:oxlint": "oxlint . --deny-warnings",
    "lint:astro": "eslint \"src/**/*.astro\" --max-warnings 0",
    "check": "astro check",
    "lint": "pnpm lint:oxlint && pnpm lint:astro && pnpm check"
  },
  "dependencies": {
    "@astrojs/mdx": "^8.0.1",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@lucide/astro": "^1.47.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.3",
    "codemirror": "^6.0.2",
    "daisyui": "^5.7.42",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "eslint": "^10.11.0",
    "eslint-plugin-astro": "^3.2.1",
    "oxfmt": "^0.68.0",
    "oxlint": "^1.83.0",
    "prettier": "^3.9.8",
    "prettier-plugin-astro": "^1.0.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0"
  },
  "engines": {
    "node": "^24.16.0 || ^26.3.0"
  },
  "packageManager": "pnpm@12.4.2"
}
